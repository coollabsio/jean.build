---

---

<nav
  class="sticky top-0 z-50 bg-[#101010]/80 backdrop-blur-md border-b border-coolgray-300/50"
>
  <div class="max-w-6xl mx-auto px-4 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-tight text-white">
      <img src="/logo.png" alt="Jean" class="w-8 h-8" />
      Jean
    </a>

    <!-- Desktop Nav -->
    <div class="hidden xl:flex items-center gap-1">
      <a
        href="/#features"
        class="text-white text-base hover:bg-coolgray-200 p-2 px-3 rounded flex items-center gap-2 transition-colors"
      >
        <i class="ph-duotone ph-lightning text-[#FCD34D] text-xl" aria-hidden="true"></i>
        Features
      </a>
      <a
        href="/docs"
        class="text-white text-base hover:bg-coolgray-200 p-2 px-3 rounded flex items-center gap-2 transition-colors"
      >
        <i class="ph-duotone ph-book-open text-[#FCD34D] text-xl" aria-hidden="true"></i>
        Docs
      </a>
      <a
        href="/philosophy"
        class="text-white text-base hover:bg-coolgray-200 p-2 px-3 rounded flex items-center gap-2 transition-colors"
      >
        <i class="ph-duotone ph-lightbulb text-[#FCD34D] text-xl" aria-hidden="true"></i>
        Philosophy
      </a>
      <a
        href="/#faq"
        class="text-white text-base hover:bg-coolgray-200 p-2 px-3 rounded flex items-center gap-2 transition-colors"
      >
        <i class="ph-duotone ph-question text-[#FCD34D] text-xl" aria-hidden="true"></i>
        FAQ
      </a>
      <a
        href="/sponsorships"
        class="text-white text-base hover:bg-coolgray-200 p-2 px-3 rounded flex items-center gap-2 transition-colors"
      >
        <i class="ph-duotone ph-coins text-[#FCD34D] text-xl" aria-hidden="true"></i>
        Sponsor Us
      </a>
      <a
        href="/changelog"
        class="text-white text-base hover:bg-coolgray-200 p-2 px-3 rounded flex items-center gap-2 transition-colors"
      >
        <i class="ph-duotone ph-clock-counter-clockwise text-[#FCD34D] text-xl" aria-hidden="true"></i>
        Changelog
      </a>
      <a
        href="https://coollabs.io/discord"
        class="text-white text-base hover:bg-coolgray-200 p-2 px-3 rounded flex items-center gap-2 transition-colors"
      >
        <i class="ph-duotone ph-game-controller text-[#FCD34D] text-xl" aria-hidden="true"></i>
        coolLabs Community (20k+)
      </a>
    </div>

    <!-- Mobile Hamburger -->
    <button
      id="menu-toggle"
      class="xl:hidden p-2 rounded hover:bg-coolgray-200 transition-colors"
      aria-label="Toggle menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <i class="ph-duotone ph-list text-white text-2xl" aria-hidden="true"></i>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden xl:hidden flex-col gap-1 px-4 pb-3">
    <a
      href="/#features"
      class="text-white text-base w-full text-left hover:bg-coolgray-200 p-2 rounded flex items-center gap-2 transition-colors"
    >
      <i class="ph-duotone ph-lightning text-[#FCD34D] text-xl" aria-hidden="true"></i>
      Features
    </a>
    <a
      href="/docs"
      class="text-white text-base w-full text-left hover:bg-coolgray-200 p-2 rounded flex items-center gap-2 transition-colors"
    >
      <i class="ph-duotone ph-book-open text-[#FCD34D] text-xl" aria-hidden="true"></i>
      Docs
    </a>
    <a
      href="/philosophy"
      class="text-white text-base w-full text-left hover:bg-coolgray-200 p-2 rounded flex items-center gap-2 transition-colors"
    >
      <i class="ph-duotone ph-lightbulb text-[#FCD34D] text-xl" aria-hidden="true"></i>
      Philosophy
    </a>
    <a
      href="/#faq"
      class="text-white text-base w-full text-left hover:bg-coolgray-200 p-2 rounded flex items-center gap-2 transition-colors"
    >
      <i class="ph-duotone ph-question text-[#FCD34D] text-xl" aria-hidden="true"></i>
      FAQ
    </a>
    <a
      href="/sponsorships"
      class="text-white text-base w-full text-left hover:bg-coolgray-200 p-2 rounded flex items-center gap-2 transition-colors"
    >
      <i class="ph-duotone ph-coins text-[#FCD34D] text-xl" aria-hidden="true"></i>
      Sponsor Us
    </a>
    <a
      href="/changelog"
      class="text-white text-base w-full text-left hover:bg-coolgray-200 p-2 rounded flex items-center gap-2 transition-colors"
    >
      <i class="ph-duotone ph-clock-counter-clockwise text-[#FCD34D] text-xl" aria-hidden="true"></i>
      Changelog
    </a>
    <a
      href="https://coollabs.io/discord"
      class="text-white text-base w-full text-left hover:bg-coolgray-200 p-2 rounded flex items-center gap-2 transition-colors"
    >
      <i class="ph-duotone ph-game-controller text-[#FCD34D] text-xl" aria-hidden="true"></i>
      coolLabs Community (20k+)
    </a>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const desktopBreakpoint = window.matchMedia("(min-width: 1280px)");

  const closeMenu = () => {
    menu?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  };

  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden") ?? true;
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(isHidden));
  });

  desktopBreakpoint.addEventListener?.("change", (event) => {
    if (event.matches) closeMenu();
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
