---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ScreenshotGallery from "../components/ScreenshotGallery.astro";
import AgentAnimation from "../components/AgentAnimation.astro";
import screenshots from "../data/screenshots.js";
import agents from "../data/agents.js";
import ArrowRight from "reicon/icons/ArrowRight";
import BranchDown from "reicon/icons/BranchDown";
import BranchUp from "reicon/icons/BranchUp";
import CheckCircle from "reicon/icons/CheckCircle";
import ChevronDown from "reicon/icons/ChevronDown";
import Code from "reicon/icons/Code";
import Cpu from "reicon/icons/Cpu";
import Download from "reicon/icons/Download";
import Flash from "reicon/icons/Flash";
import Layers from "reicon/icons/Layers";
import Link from "reicon/icons/Link";
import MagicWand from "reicon/icons/MagicWand";
import Maximize from "reicon/icons/Maximize";
import Plug from "reicon/icons/Plug";
import Server from "reicon/icons/Server";
import Sliders from "reicon/icons/Sliders";
import TerminalSquare from "reicon/icons/TerminalSquare";

const features = [
  { icon: BranchUp, title: "Isolated workspaces", text: "Every task gets its own git worktree." },
  { icon: Layers, title: "Parallel agents", text: "Run many agents at once, without conflicts." },
  { icon: TerminalSquare, title: "Magic git commands", text: "Commit, review, open PRs, fix conflicts.", href: "/docs/workflows/magic-commands" },
  { icon: MagicWand, title: "Magic prompts", text: "Edit every prompt, pick a model per workflow.", href: "/docs/manage/magic-prompts" },
  { icon: Cpu, title: "Mr. Robot", beta: true, text: "Sweeps GitHub issues and drafts plans." },
  { icon: Link, title: "Linked projects", text: "Share context across related repos.", href: "/docs/core-concepts/project-linking" },
  { icon: BranchDown, title: "Automated merging", text: "Merge PRs or worktrees, AI fixes conflicts." },
  { icon: Plug, title: "Linear integration", text: "Load Linear issues into any session." },
  { icon: Flash, title: "Fewer tokens", text: "RTK cuts tool-output tokens by 60-90%.", href: "/docs/manage/opinionated-plugins" },
  { icon: Server, title: "Local + remote", text: "Projects from all servers in one sidebar.", href: "#web-access" },
  { icon: Sliders, title: "Opinionated", text: "Good defaults, no endless configuration." },
  { icon: Code, title: "Open source", text: "Apache 2.0. Free forever." },
];

const faqs = [
  {
    q: "What is Jean?",
    a: "Jean is an open-source AI assistant that helps you manage multiple projects, worktrees, and sessions with Claude CLI, Codex CLI, OpenCode, Cursor, Pi, Command Code, Grok, and Kimi Code. Use it as a desktop app, or run it on a server and connect from a browser or the native app - same projects and sessions either way.",
  },
  {
    q: "Can I run Jean on a server?",
    a: "Yes. Install <code class=\"font-mono text-fg-dim\">jean-server</code> on Linux (or enable Web Access in the desktop app). Add it in the desktop app under <strong class=\"text-fg-dim\">Connections → Add remote</strong> (or let Jean install it over SSH): its projects appear in the same sidebar as your local ones, grouped by server. You can also open the full UI in a browser with an access token. We recommend binding on Tailscale (or similar) instead of the public internet. See <a href=\"/docs/manage/web-access-and-headless\" class=\"text-link\">Web Access and headless</a>.",
  },
  {
    q: "Is Jean really free?",
    a: "Yes, 100%. Jean is open source under the Apache 2.0 license. There are no paid tiers, no feature gates, and no usage limits. You bring your own subscription for any supported AI coding agent. If you'd like to support development, consider <a href=\"/sponsorships\" class=\"text-link\">sponsoring us</a>.",
  },
  {
    q: "What platforms does Jean support?",
    a: "The desktop app is tested on macOS; Windows and Linux desktop builds work but need more testing. Headless <code class=\"font-mono text-fg-dim\">jean-server</code> targets Linux amd64/arm64. Download release builds from GitHub - Node.js and Rust are only required if you build from source.",
  },
  {
    q: "How does Jean work with git?",
    a: "Jean uses git worktrees to create isolated workspaces for each AI agent session. It automates common git operations like reviewing code, creating commits, opening PRs, and resolving merge conflicts. Each workspace is independent, so multiple agents can work on different branches simultaneously.",
  },
  {
    q: "What AI models does Jean use?",
    a: "Jean supports Claude CLI, Codex CLI, OpenCode, Cursor, Pi, Command Code, Grok, and Kimi Code. Pi, Command Code, and Kimi Code are currently beta integrations. You bring your own subscription or API access for each provider.",
  },
  {
    q: "Does Jean help reduce token usage?",
    a: "Yes. The Opinionated pane installs RTK (a CLI proxy that compresses tool outputs 60-90% across every backend) and Caveman (a Claude skill that produces terse replies, ~65-75% shorter) with one click. See <a href=\"/docs/manage/opinionated-plugins\" class=\"text-link\">Opinionated Plugins</a>.",
  },
  {
    q: "How do I contribute?",
    a: "We welcome contributions of all kinds - code, documentation, bug reports, and feature requests. Check out the <a href=\"https://github.com/coollabsio/jean\" class=\"text-link\" target=\"_blank\">repository's CONTRIBUTING.md</a> to get started.",
  },
  {
    q: "Why is Jean opinionated?",
    a: "We believe developer tools should make decisions for you, not present you with a wall of configuration options. Jean picks the best workflows - git worktrees for isolation, automated merging, structured context loading - so you can focus on building. If a workflow is clearly better, we just do it that way.",
  },
];
---

<Layout>
  <section class="px-4 pt-12 text-center md:pt-20">
    <a
      href="https://coollabs.io/philosophy"
      class="inline-flex items-center gap-2 rounded-full bg-white/[0.04] px-3 py-1 text-xs text-fg-dim ring-1 ring-hairline transition-colors hover:bg-white/[0.07] hover:text-fg"
    >
      <span class="size-1.5 rounded-full bg-warning"></span>
      Open source and free forever. Read our philosophy
      <Icon icon={ArrowRight} class="size-3.5" />
    </a>
    <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-semibold tracking-tight text-balance text-fg md:text-6xl">
      A dev environment for AI agents<span class="text-warning">.</span>
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-base text-pretty text-fg-dim md:text-lg">
      An opinionated AI agent workspace. Git worktrees, chat sessions, terminals,
      and GitHub &amp; Linear integrations in one cohesive workflow. Run it on
      your laptop or a dedicated server - connect from a browser or the native app.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <div class="relative">
        <div class="flex">
          <a id="download-btn" href="https://github.com/coollabsio/jean/releases/latest" class="btn btn-primary btn-lg rounded-r-none">
            <Icon icon={Download} class="size-4" />
            <span id="download-label">Download for your platform</span>
            <span id="download-version" class="font-mono text-xs text-app/60"></span>
          </a>
          <button
            id="download-dropdown-toggle"
            type="button"
            aria-label="Show all platforms"
            aria-expanded="false"
            class="btn btn-primary btn-lg rounded-l-none border-l border-app/15 px-2.5"
          >
            <Icon icon={ChevronDown} class="size-4 transition-transform duration-200" />
          </button>
        </div>
        <div id="download-dropdown" class="absolute top-full right-0 left-0 z-50 mt-2 hidden overflow-hidden rounded-lg bg-panel text-left ring-1 ring-hairline shadow-2xl shadow-black/40 sm:left-auto sm:w-96">
          <div id="download-dropdown-list" class="divide-y divide-hairline font-mono text-xs"></div>
        </div>
      </div>
      <a href="#web-access" class="btn btn-neutral btn-lg">
        <Icon icon={Server} class="size-4" />
        Run on a server
      </a>
    </div>
    <p class="mt-4 text-xs text-fg-faint">
      Tested on macOS. Windows &amp; Linux
      <a href="https://github.com/coollabsio/jean" target="_blank" class="text-link">testers needed</a>.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-fg-faint">
      <span class="eyebrow">Works with</span>
      {
        agents.map((agent) => (
          <svg class="size-5" role="img" viewBox={agent.viewBox} fill={agent.fill} aria-label={agent.name} set:html={agent.body} />
        ))
      }
    </div>
  </section>

  <section class="mt-14 px-4 text-center" aria-label="Jean screenshots">
    <button
      type="button"
      data-gallery-open="0"
      class="group relative block w-full cursor-zoom-in rounded-xl bg-white/[0.03] p-1.5 ring-1 ring-hairline transition-colors hover:ring-white/15 focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-warning"
    >
      <img
        src={screenshots[0].src}
        alt={screenshots[0].alt}
        width="2880"
        height="1800"
        fetchpriority="high"
        class="w-full rounded-lg"
      />
      <span class="absolute right-4 bottom-4 inline-flex items-center gap-1.5 rounded-full bg-app/80 px-3 py-1.5 text-xs font-medium text-fg ring-1 ring-hairline backdrop-blur transition-colors group-hover:bg-app">
        <Icon icon={Maximize} class="size-3.5" />
        View all {screenshots.length} screenshots
      </span>
    </button>
    <p class="mt-3 text-[13px] text-fg-faint">
      <span class="text-fg-dim">{screenshots[0].title}.</span> {screenshots[0].text}
    </p>
    <div class="mt-4 grid grid-cols-3 gap-2 sm:grid-cols-6">
      {
        screenshots.slice(1).map((shot, index) => (
          <button
            type="button"
            data-gallery-open={index + 1}
            aria-label={`Open screenshot: ${shot.title}`}
            class="overflow-hidden rounded-md opacity-70 ring-1 ring-hairline transition-opacity hover:opacity-100 focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-warning max-sm:nth-[n+4]:hidden"
          >
            <img src={shot.src} alt="" loading="lazy" class="aspect-[16/10] w-full object-cover object-top" />
          </button>
        ))
      }
    </div>
  </section>

  <section id="how-it-works" class="mt-28 scroll-mt-20 px-4 text-center">
    <p class="eyebrow">How it works</p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-fg md:text-3xl">
      Bring your own agent.
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-sm text-fg-faint">
      Pick an issue, a PR or just a prompt, then choose the backend. Use one per
      task or run several at once - each in its own git worktree.
    </p>
    <div class="mt-10">
      <AgentAnimation />
    </div>
  </section>

  <section id="web-access" class="mt-28 scroll-mt-20 px-4">
    <div class="card grid items-center gap-10 p-6 md:p-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="eyebrow">Local · Remote · Web</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-fg md:text-3xl">
          Local and remote, in one sidebar<span class="text-warning">.</span>
        </h2>
        <p class="mt-4 text-sm text-fg-dim md:text-base">
          Run <code class="font-mono text-fg">jean-server</code> on any Linux box and
          add it to the desktop app. Its projects show up next to your local ones,
          grouped by server. No switching - every session, terminal and git action
          runs on the server that owns the project.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-fg-dim">
          <li class="flex gap-3">
            <Icon icon={CheckCircle} class="mt-0.5 size-4 shrink-0 text-warning" />
            <span><strong class="font-medium text-fg">Many servers</strong> - add as many remotes as you want, or install one over SSH from the app.</span>
          </li>
          <li class="flex gap-3">
            <Icon icon={CheckCircle} class="mt-0.5 size-4 shrink-0 text-warning" />
            <span><strong class="font-medium text-fg">Agents keep running</strong> - close your laptop, the work continues on the server.</span>
          </li>
          <li class="flex gap-3">
            <Icon icon={CheckCircle} class="mt-0.5 size-4 shrink-0 text-warning" />
            <span><strong class="font-medium text-fg">Browser too</strong> - every server serves the full UI, token-protected. Tailscale recommended.</span>
          </li>
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/docs/manage/web-access-and-headless" class="btn btn-primary">
            Read the guide
            <Icon icon={ArrowRight} class="size-4" />
          </a>
          <a href="https://github.com/coollabsio/jean#web-access" target="_blank" rel="noopener noreferrer" class="btn btn-neutral">
            Install jean-server
          </a>
        </div>
      </div>

      <div class="rounded-lg bg-app/60 p-4 text-sm ring-1 ring-hairline md:p-5" aria-hidden="true">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
          <span class="font-medium text-fg">Projects</span>
          <span class="rounded-md bg-white/[0.06] px-2 py-0.5 text-xs text-fg-dim ring-1 ring-hairline">All servers</span>
        </div>
        {
          [
            { server: "Local", projects: [["jean.build", 1], ["coolify.io", 4]] },
            { server: "devserver", projects: [["coolify", 22, true], ["sentinel", 1, true]] },
            { server: "hetzner-vps", projects: [["orbit", 3]] },
          ].map((group) => (
            <div class="mt-3">
              <p class="eyebrow flex items-center gap-1.5 text-[10px]">
                <span class:list={["size-1.5 rounded-full", group.server === "Local" ? "bg-fg-faint" : "bg-success"]} />
                {group.server}
              </p>
              <div class="mt-1.5 space-y-1">
                {group.projects.map(([name, count, running]) => (
                  <div class="flex items-center justify-between rounded-md px-2 py-1 text-fg-dim hover:bg-white/[0.04]">
                    <span class="flex items-center gap-2">
                      {name}
                      {running && <span class="size-1.5 animate-pulse rounded-full bg-warning" />}
                    </span>
                    <span class="font-mono text-xs text-fg-faint">{count}</span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="features" class="mt-28 scroll-mt-20 px-4 text-center">
    <p class="eyebrow">Features</p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-fg md:text-3xl">
      Everything you need
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-sm text-fg-faint">
      Opinionated by design. <a href="/docs" class="text-link">Read the docs</a> for the details.
    </p>
    <div class="mt-10 grid gap-3 text-left sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((feature) => (
          <div class="card flex items-start gap-3 p-4">
            <Icon icon={feature.icon} class="mt-0.5 size-4 shrink-0 text-warning" />
            <div>
              <h3 class="flex items-center gap-2 text-sm font-medium text-fg">
                {feature.title}
                {feature.beta && <span class="rounded-full px-1.5 text-[10px] tracking-wide text-warning uppercase ring-1 ring-warning/30">Beta</span>}
              </h3>
              <p class="mt-0.5 text-[13px] leading-5 text-fg-faint">{feature.text}</p>
              {feature.href && (
                <a href={feature.href} class="mt-2 inline-flex items-center gap-1 text-[13px] text-fg-dim transition-colors hover:text-warning">
                  {feature.href.startsWith("#") ? "See how it works" : "Learn more"}
                  <Icon icon={ArrowRight} class="size-3.5" />
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="faq" class="mt-28 scroll-mt-20 px-4">
    <div class="text-center">
      <p class="eyebrow">FAQ</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-fg md:text-3xl">
        Frequently asked questions
      </h2>
    </div>
    <div class="mx-auto mt-10 max-w-3xl divide-y divide-hairline border-y border-hairline">
      {
        faqs.map((faq) => (
          <details name="faq" class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-sm font-medium text-fg [&::-webkit-details-marker]:hidden">
              {faq.q}
              <Icon icon={ChevronDown} class="size-4 shrink-0 text-fg-faint transition-transform duration-200 group-open:rotate-180" />
            </summary>
            <p class="pb-4 text-sm text-fg-dim" set:html={faq.a} />
          </details>
        ))
      }
    </div>
  </section>

  <ScreenshotGallery />
</Layout>

<script>
  // OS-aware download button
  const btn = document.getElementById("download-btn") as HTMLAnchorElement;
  const label = document.getElementById("download-label");
  const version = document.getElementById("download-version");
  const dropdownToggle = document.getElementById("download-dropdown-toggle");
  const dropdown = document.getElementById("download-dropdown");
  const dropdownList = document.getElementById("download-dropdown-list");

  const ua = navigator.userAgent.toLowerCase();
  let os = "unknown";
  if (ua.includes("mac")) os = "mac";
  else if (ua.includes("win")) os = "windows";
  else if (ua.includes("linux")) os = "linux";

  const isArm = /aarch64|arm/i.test(navigator.platform);

  const osLabels: Record<string, string> = {
    mac: "Download for macOS",
    windows: "Download for Windows",
    linux: isArm ? "Download for Linux (ARM)" : "Download for Linux (x64)",
    unknown: "Download Latest Release",
  };

  if (label) label.textContent = osLabels[os];

  // Friendly names for assets
  const assetLabels: Record<string, string> = {
    ".dmg": "macOS (DMG)",
    "-setup.exe": "Windows (EXE)",
    ".msi": "Windows (MSI)",
    "_amd64.AppImage": "Linux x64 (AppImage)",
    "_arm64.AppImage": "Linux ARM (AppImage)",
    "_amd64.deb": "Linux x64 (DEB)",
    "_arm64.deb": "Linux ARM (DEB)",
    "x86_64.rpm": "Linux x64 (RPM)",
    "aarch64.rpm": "Linux ARM (RPM)",
  };

  const assetOrder = [".dmg", "-setup.exe", ".msi", "_amd64.AppImage", "_arm64.AppImage", "_amd64.deb", "_arm64.deb", "x86_64.rpm", "aarch64.rpm"];
  const osExtMap: Record<string, string> = { mac: ".dmg", windows: "-setup.exe", linux: isArm ? "_arm64.AppImage" : "_amd64.AppImage" };
  const recommendedExt = osExtMap[os];

  const setDropdownOpen = (open: boolean) => {
    dropdown?.classList.toggle("hidden", !open);
    dropdownToggle?.setAttribute("aria-expanded", String(open));
    const chevron = dropdownToggle?.querySelector("svg");
    if (chevron) chevron.style.transform = open ? "rotate(180deg)" : "";
  };

  dropdownToggle?.addEventListener("click", () => setDropdownOpen(dropdown?.classList.contains("hidden") ?? false));
  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    if (!target.closest("#download-dropdown-toggle") && !target.closest("#download-dropdown")) setDropdownOpen(false);
  });

  // Cache release data in localStorage (10 min TTL)
  const CACHE_KEY = "jean-release-v4";
  const CACHE_TTL = 10 * 60 * 1000;

  type Asset = { name: string; browser_download_url: string };
  type Release = { tag_name: string; assets: Asset[] };
  type MergedAsset = { ext: string; name: string; url: string; tag: string; isOlder: boolean };

  function mergeReleases(releases: Release[]): { latestTag: string; merged: Record<string, MergedAsset> } {
    const latestTag = releases[0]?.tag_name || "";
    const merged: Record<string, MergedAsset> = {};
    for (const ext of assetOrder) {
      for (const rel of releases) {
        const asset = (rel.assets || []).find((a) => a.name.endsWith(ext));
        if (asset) {
          merged[ext] = { ext, name: asset.name, url: asset.browser_download_url, tag: rel.tag_name, isOlder: rel.tag_name !== latestTag };
          break;
        }
      }
    }
    return { latestTag, merged };
  }

  function applyMergedData(latestTag: string, merged: Record<string, MergedAsset>) {
    if (version) version.textContent = latestTag;

    const primary = merged[recommendedExt];
    if (primary && btn) btn.href = primary.url;

    if (dropdownList) {
      dropdownList.innerHTML = "";
      for (const ext of assetOrder) {
        const entry = merged[ext];
        if (!entry) continue;
        const link = document.createElement("a");
        link.href = entry.url;
        link.className = `flex ${entry.isOlder ? "items-start" : "items-center"} justify-between gap-4 px-4 py-2.5 text-fg transition-colors hover:bg-white/[0.06]`;
        const recommended = ext === recommendedExt;
        const badge = recommended ? `<span class="ml-2 text-success">Recommended</span>` : "";
        const building = entry.isOlder ? `<div class="text-warning">Currently building ${latestTag}...</div>` : "";
        const filename = entry.isOlder ? `${entry.name} (${entry.tag})` : entry.name;
        link.innerHTML = `<div class="shrink-0"><div>${assetLabels[ext] || entry.name}${badge}</div>${building}</div><span class="truncate text-fg-faint">${filename}</span>`;
        dropdownList.appendChild(link);
      }
    }
  }

  let cached: { ts: number; releases: Release[] } | null = null;
  try {
    const raw = localStorage.getItem(CACHE_KEY);
    if (raw) cached = JSON.parse(raw);
  } catch {}

  if (cached && Date.now() - cached.ts < CACHE_TTL) {
    const { latestTag, merged } = mergeReleases(cached.releases);
    applyMergedData(latestTag, merged);
  } else {
    fetch("https://api.github.com/repos/coollabsio/jean/releases?per_page=5")
      .then((res) => res.json())
      .then((releases: Release[]) => {
        const valid = releases.filter((r) => r.assets && r.assets.length > 0);
        if (valid.length) {
          try { localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), releases: valid })); } catch {}
          const { latestTag, merged } = mergeReleases(valid);
          applyMergedData(latestTag, merged);
        } else if (btn) {
          btn.href = "https://github.com/coollabsio/jean/releases/latest";
        }
      })
      .catch(() => {
        if (cached) {
          const { latestTag, merged } = mergeReleases(cached.releases);
          applyMergedData(latestTag, merged);
        } else if (btn) {
          btn.href = "https://github.com/coollabsio/jean/releases/latest";
        }
      });
  }
</script>
