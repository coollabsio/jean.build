---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Jean - A dev environment for AI agents.',
  description = 'Run AI agents in parallel in isolated workspaces - on your laptop or a server. Connect from a browser or the native app. Works with Claude, Codex, OpenCode, Cursor, Pi, Command Code, Grok, and Kimi Code. Open source and free forever.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Jean" />
    <meta property="og:image" content="https://cdn.coollabs.io/og-images/jean.png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Jean: a dev environment for AI agents. Run Claude, Codex and more in parallel, each in its own git worktree." />
    <meta property="og:url" content="https://jean.build" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cdn.coollabs.io/og-images/jean.png" />
    <meta name="twitter:image:alt" content="Jean: a dev environment for AI agents. Run Claude, Codex and more in parallel, each in its own git worktree." />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>

    <!-- Analytics -->
    <script defer data-domain="jean.build" src="https://analytics.coollabs.io/js/script.js"></script>
  </head>
  <body class="font-sans leading-relaxed text-fg antialiased">
    <Navigation />
    <main class="mx-auto max-w-6xl">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @reference "../styles/global.css";

  html {
    scroll-behavior: smooth;
    background-color: var(--color-app);
    color: var(--color-fg);
    color-scheme: dark;
  }
  @supports (overflow-x: clip) {
    html,
    body {
      overflow-x: clip;
    }
  }
  /* Yellow glow at the top (Jean accent). */
  body {
    background:
      radial-gradient(circle at 50% 0%, color-mix(in oklab, var(--color-warning) 7%, transparent), transparent 34rem),
      var(--color-app);
  }
  ::selection {
    background: color-mix(in oklch, var(--color-coollabs) 45%, transparent);
  }
  .navbar-link {
    @apply flex h-8 items-center gap-2 rounded-md px-2.5 text-sm text-fg-dim transition-colors hover:bg-white/[0.06] hover:text-fg;
  }
  @media (max-width: 1279px) {
    .navbar-link {
      @apply h-9 w-full px-3 text-left;
    }
  }
  /* Inline links in body copy. */
  .text-link {
    @apply text-fg underline decoration-fg-faint underline-offset-2 transition-colors hover:decoration-fg;
  }
</style>
